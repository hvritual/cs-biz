{
  "type": "object",
  "properties": {
    "protocol": {
      "const": "sdlc-artifact-v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "design",
        "build",
        "deploy"
      ]
    },
    "step": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "not_applicable",
        "blocked",
        "failed"
      ]
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "contract": {
      "type": "object"
    },
    "payload": {
      "type": "object"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "owner",
          "next_action",
          "evidence_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "protocol",
    "task_id",
    "stage",
    "step",
    "status",
    "input_sha256",
    "contract",
    "payload",
    "assets",
    "blockers",
    "definition_sha256"
  ],
  "additionalProperties": false
}
