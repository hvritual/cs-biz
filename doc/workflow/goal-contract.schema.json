{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "goal-contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "goal-v1"
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_ref": {
      "type": "string",
      "pattern": "^https://github.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$"
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "result",
          "verification"
        ]
      },
      "minItems": 1
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "allowed_paths",
        "forbidden_paths"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "max_attempts"
      ]
    },
    "wake_events": {
      "type": "array",
      "items": {
        "enum": [
          "new_evidence",
          "dependency_resolved",
          "human_decision",
          "candidate_changed"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "goal_id",
    "authority_ref",
    "outcome",
    "acceptance",
    "invariants",
    "scope",
    "budget",
    "wake_events"
  ]
}
