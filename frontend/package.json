{
  "name": "@cs-biz/frontend",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/hvritual/cs-biz.git",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cs-biz/console dev",
    "build": "cross-env TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run build --filter=@cs-biz/console",
    "preview": "pnpm --filter @cs-biz/console preview",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "node -e \"if (Number(process.versions.node.split('.')[0]) < 22) process.exit(1)\"",
    "typecheck": "pnpm --filter @cs-biz/console typecheck",
    "lint": "oxlint apps/console/src --deny-warnings",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --config ci/playwright.config.ts",
    "check:copy": "node ci/check-copy.mjs",
    "check": "pnpm check:full",
    "check:desktop": "node ci/check-desktop-ui.mjs",
    "check:delivery-policy": "node ci/check-delivery-policy.mjs",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm check:copy && pnpm check:desktop && pnpm check:delivery-policy && pnpm test:unit",
    "check:full": "pnpm check:fast && pnpm build && pnpm test:e2e",
    "test:e2e:desktop": "playwright test --config ci/playwright.config.ts desktop-ui.spec.ts",
    "check:desktop:runtime": "pnpm build && pnpm test:e2e:desktop"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxfmt-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:",
    "@playwright/test": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4"
}
